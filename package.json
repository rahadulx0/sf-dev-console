{
  "name": "sf-dev-console",
  "private": true,
  "version": "0.1.0",
  "description": "A local desktop GUI for Salesforce CLI developer workflows",
  "main": "desktop/dist/main.js",
  "author": "Rahadul",
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @sf-console/server\" \"npm run dev -w @sf-console/web\"",
    "build": "npm run build -w @sf-console/server && npm run build -w @sf-console/web && npm run build:desktop",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build:icon": "electron desktop/scripts/generate-icon.mjs",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "dist:windows": "npm run build && electron-builder --win nsis --x64",
    "start": "npm run start -w @sf-console/server",
    "typecheck": "npm run typecheck -w @sf-console/server && npm run typecheck -w @sf-console/web",
    "test": "npm run test -w @sf-console/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.rahadul.sfdevconsole",
    "productName": "SF Dev Console",
    "asar": true,
    "files": [
      "client/dist/**/*",
      "server/dist/**/*",
      "server/package.json",
      "desktop/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "repository": "https://github.com/rahadulx0/sf-dev-console"
    },
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "desktop/assets/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SF Dev Console",
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "SF Dev Console",
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 160,
          "y": 190,
          "type": "file"
        },
        {
          "x": 440,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "SF-Dev-Console-${version}-${arch}.${ext}"
  }
}
